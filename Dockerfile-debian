# byteshaver runtime image — Debian variant.
#
# Same prebuilt static-pie binary as the alpine image (a musl static binary
# runs on any Linux kernel regardless of the host libc), on a debian base for
# glibc-oriented environments. Placed into the build context by the CI jobs.
FROM debian:trixie-slim
COPY byteshaver /usr/local/bin/byteshaver
RUN chmod +x /usr/local/bin/byteshaver
WORKDIR /targets
CMD ["byteshaver"]
